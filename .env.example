# MudraSense AI runtime configuration
# Copy this file to .env and replace values as needed.

# Inference backend: ollama or groq
MUDRASENSE_PROVIDER=ollama

# Groq hosted inference. Required only when MUDRASENSE_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Local Ollama inference. Required only when MUDRASENSE_PROVIDER=ollama.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:70b

# Input and network settings
MUDRASENSE_INPUT=positions.csv
MUDRASENSE_MARKET_TIMEOUT_SECONDS=10
MUDRASENSE_NEWS_TIMEOUT_SECONDS=10

# Supervisor guardrails; values are negative percentages.
MUDRASENSE_LOSS_THRESHOLD_PERCENT=-5.00
MUDRASENSE_INTRADAY_DROP_THRESHOLD_PERCENT=-3.00

# Optional future webhook endpoints. The current implementation only prints alerts.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
